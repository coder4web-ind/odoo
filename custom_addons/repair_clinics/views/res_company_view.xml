<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_repair" model="ir.ui.view">
        <field name="name">res.company.form.inherit.repair</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_registry']" position="after">
                <field name="company_type_role" selection="[('network', 'Network'), ('client', 'Client'), ('branch', 'Branch'), ('service_provider', 'Service Provider')]"/>
            </xpath>
        </field>
    </record>
</odoo>