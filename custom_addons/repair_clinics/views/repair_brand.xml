<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="repair_clinic_brand_action" model="ir.actions.act_window">
        <field name="name">View Brand</field>        
        <field name="res_model">repair.device.brand</field>
        <field name="view_mode">list,form</field>        
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Brands
          </p>          
        </field>
    </record>

    <record id="repair_clinic_brand_view_list" model="ir.ui.view"> 
      <field name="name">repair.device.list</field>
      <field name="model">repair.device.brand</field> 
      <field name="arch" type="xml">
        <list string="Repair Device Brand Grid">
          <field name="name" string="Name"/>
          <field name="code" string="Code"/>          
          <field name="imei_required" string="Imei Required"/>
          <field name="serial_no_required" string="Serial No Required"/>          
        </list>
      </field>
    </record>

    <record id="view_repair_clinic_brand_form" model="ir.ui.view">
      <field name="name">repair.clinic.device.brand.form</field>
      <field name="model">repair.device.brand</field> 
      <field name="arch" type="xml">
      <form string="New Job" create="1" edit="1">
        <header>
            <button special="save" class="btn btn-primary me-1" icon="fa-book" string="Save"/>
            <button special="cancel"  class="btn btn-danger"  icon="fa-arrow-left"  string="Cancel"/>
        </header>
        <sheet>
          <group string="Global Brand Configuration">
            <group>
                <field name="logo" widget="image" class="oe_avatar"/>
                <field name="name" string="Brand"/>
                <field name="code" string="Code"/>                
                <field name="active"/>
            </group>
            <group>              
                <field name="imei_required" string="Imei Required" />
                <field name="serial_no_required" string="Serial No Required"  />                
            </group>
          </group>          
        </sheet>
      </form>
      </field>
    </record>
</odoo>