<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="repair_clinic_model_action" model="ir.actions.act_window">
        <field name="name">View Device Model</field>        
        <field name="res_model">repair.model</field>
        <field name="view_mode">list,form</field>        
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Device Model
          </p>
          <p>
            Use device details to book a job using IMEI or Serial No.
          </p>
        </field>
    </record>

    <record id="repair_clinic_model_view_list" model="ir.ui.view"> 
      <field name="name">repair.model.list</field>
      <field name="model">repair.model</field> 
      <field name="arch" type="xml">
        <list string="Repair Device Model Grid">
          <field name="name" string="Name"/>
          <field name="code" string="Code"/>
          <field name="manufacturer_id" string="Manufacturer"/>
          <field name="device_type_id" string="Unit Type"/>
          <field name="imei_required" string="Imei Required"/>
          <field name="serial_no_required" string="Serial No Required"/>          
        </list>
      </field>
    </record>

    <record id="view_repair_clinic_model_form" model="ir.ui.view">
      <field name="name">repair.model.form</field>
      <field name="model">repair.model</field> 
      <field name="arch" type="xml">
      <form string="New Device Model" create="1" edit="1">
        <header>
            <button special="save" class="btn btn-primary me-1" icon="fa-book" string="Save"/>
            <button special="cancel"  class="btn btn-danger"  icon="fa-arrow-left"  string="Cancel"/>
        </header>
        <sheet>
          <group string="Global Device Model Configuration">
            <group>                
                <field name="name" string="Device Model"/>                
                <field name="manufacturer_id" string="Manufacturer" />
                <field name="device_type_id" string="Device Type"/>
                <field name="active"/>
            </group>
            <group>
              <field name="code" string="Model Code"/>
              <field name="description" string="Description" />             
              <field name="imei_required" string="Imei Required" />
              <field name="serial_no_required" string="Serial No Required"  />                
            </group>
          </group>          
        </sheet>
      </form>
      </field>
    </record>
</odoo>