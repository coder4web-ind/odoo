<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="repair_clinic_comapany_manufacturer_rel_form" model="ir.ui.view">
        <field name="name">repair.company.manufacturer.rel.form</field>
        <field name="model">repair.company.manufacturer.rel</field> 
        <field name="arch" type="xml">
            <form string="Service Provider Details">
                <sheet>
                    <group string="API Credentials">
                        <group>
                            <field name="company_id"/>
                            <field name="account_no"/>
                            <field name="communication"/>
                        </group>
                        <group>
                            <field name="comm_user_name"/>
                            <field name="comm_password" password="True"/>
                            <field name="token"/>
                        </group>
                    </group>
                    <group string="Contact Info &amp; Location Address">
                        <group>
                            <field name="contact_person"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="street"/>
                            <field name="city"/>
                            <field name="zip"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button special="save" string="Save" class="btn-primary"/>
                    <button special="cancel" string="Discard" class="btn-secondary"/>
                </footer>
            </form>
        </field> 
    </record>

    <record id="view_repair_company_manufacturer_rel_tree" model="ir.ui.view">
        <field name="name">repair.company.manufacturer.rel.list</field>
        <field name="model">repair.company.manufacturer.rel</field>
        <field name="arch" type="xml">
            <list string="Companies" editable="top">
                <button type="object" 
                        name="action_open_popup" 
                        icon="fa-external-link" 
                        class="btn-primary"
                        string="Edit"
                        title="Open in Popup Form"/>
                <field name="company_id"/>
                <field name="contact_person"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="city"/>
                <field name="communication"/>
                <field name="active"/>                
            </list>            
        </field>
    </record>
</odoo>