<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="repair_clinic_device_category_action" model="ir.actions.act_window">
        <field name="name">View Device Category</field>        
        <field name="res_model">repair.device.category</field>
        <field name="view_mode">list,form</field>        
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Device Categories
          </p>          
        </field>
    </record>

    <record id="repair_clinic_device_category_view_list" model="ir.ui.view"> 
      <field name="name">repair.clinic.device.category.list</field>
      <field name="model">repair.device.category</field> 
      <field name="arch" type="xml">
        <list string="Repair Device Unit Type Grid">
          <field name="name" string="Name"/>          
          <field name="imei_required" string="Imei Required"/>
          <field name="serial_no_required" string="Serial No Required"/>
        </list>
      </field>
    </record>

    <record id="view_repair_clinic_device_category_form" model="ir.ui.view">
      <field name="name">repair.clinic.device.category.form</field>
      <field name="model">repair.device.category</field> 
      <field name="arch" type="xml">
      <form string="New Device Category" create="1" edit="1">
        <header>
            <button special="save" class="btn btn-primary me-1" icon="fa-book" string="Save"/>
            <button special="cancel"  class="btn btn-danger"  icon="fa-arrow-left"  string="Cancel"/>
        </header>
        <sheet>
          <group string="Global Device Category Configuration">
            <group>                
                <field name="name" string="Device Category"/>
                <field name="imei_required" string="Imei Required" />
                <field name="serial_no_required" string="Serial No Required"  />                
            </group>
            <group>                
                <field name="ranking" string="Ranking" />
                <field name="active"/>
            </group>
          </group>          
        </sheet>
      </form>
      </field>
    </record>
</odoo>