<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="repair_clinic_device_action" model="ir.actions.act_window">
        <field name="name">View Device</field>        
        <field name="res_model">repair.device</field>
        <field name="view_mode">list,form</field>        
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Devices
          </p>          
        </field>
    </record>

    <record id="repair_clinic_device_view_list" model="ir.ui.view"> 
      <field name="name">repair.device.list</field>
      <field name="model">repair.device</field> 
      <field name="arch" type="xml">
        <list string="Repair Device Model Grid">
          <field name="name" string="Name"/>
          <field name="code" string="Code"/>
          <field name="device_brand_id" string="Brand"/>
          <field name="device_category_id" string="Category"/>
          <field name="imei_required" string="Imei Required"/>
          <field name="serial_no_required" string="Serial No Required"/>          
        </list>
      </field>
    </record>

    <record id="view_repair_clinic_device_form" model="ir.ui.view">
      <field name="name">repair.device.form</field>
      <field name="model">repair.device</field> 
      <field name="arch" type="xml">
      <form string="New Device Model" create="1" edit="1">
        <header>
            <button special="save" class="btn btn-primary me-1" icon="fa-book" string="Save"/>
            <button special="cancel"  class="btn btn-danger"  icon="fa-arrow-left"  string="Cancel"/>
        </header>
        <sheet>
          <group string="Global Devices Configuration">
            <group>
                <field name="name" string="Device Name"/>                
                <field name="device_brand_id" string="Brand" />
                <field name="device_category_id" string="Device Category"/>
                <field name="active"/>
            </group>
            <group>
              <field name="code" string="Device Code"/>
              <field name="description" string="Description" />             
              <field name="imei_required" string="Imei Required" />
              <field name="serial_no_required" string="Serial No Required"  />                
            </group>
          </group>          
        </sheet>
      </form>
      </field>
    </record>
</odoo>