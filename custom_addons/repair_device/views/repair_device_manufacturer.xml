<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="repair_device_manufacturer_action" model="ir.actions.act_window">
        <field name="name">View Manufacturer</field>        
        <field name="res_model">repair.device.manufacturer</field>
        <field name="view_mode">list,form</field>        
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Manufacturer
          </p>
          <p>
            Use manufacturer/device details to book a job using IMEI or Serial No.
          </p>
        </field>
    </record>

    <record id="view_repair_device_manufacturer_form" model="ir.ui.view">
      <field name="name">repair.device.manufacturer.form</field>
      <field name="model">repair.device.manufacturer</field> 
      <field name="arch" type="xml">
      <form string="New Job" create="1" edit="1">
        <header>
            <button special="save" class="btn btn-primary me-1" icon="fa-book" string="Save"/>
            <button special="cancel"  class="btn btn-danger"  icon="fa-arrow-left"  string="Cancel"/>
        </header>
        <sheet>
          <group string="Global Manufacturer Configuration">
            <group>
                <field name="logo" widget="image" class="oe_avatar"/>
                <field name="name" string="Manufacturer"/>
                <field name="acronym" string="Acronym"/>
                <field name="etd_date_enabled" string="Estimated Time of Delivery Enabled" />
                <field name="etd_date_days" string="Estimated Time of Delivery (days)" />
                <field name="active"/>
            </group>
            <group>              
                <field name="imei_required" string="Imei Required" />
                <field name="serial_no_required" string="Serial No Required"  />
                <field name="serial_no_format" string="Serial No Format" help="use X for numeric,A for Alphabats,N for alphanumeric,and if any special chracter like -,#,@" />
                <field name="pop_period" string="Proof of Purchase Period" />
            </group>
          </group>          
        </sheet>
      </form>
      </field>
    </record>
</odoo>