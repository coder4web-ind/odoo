<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="company_default_network" model="res.company">
            <field name="name">Direct Bookings Network</field>
            <field name="company_type_role">network</field>
        </record>

        <record id="company_default_client" model="res.company">
            <field name="name">Direct Walk-in Client</field>
            <field name="company_type_role">client</field>
            <field name="parent_id" ref="company_default_network"/>
        </record>

        <record id="company_default_branch" model="res.company">
            <field name="name">Direct Service Branch</field>
            <field name="company_type_role">branch</field>
            <field name="parent_id" ref="company_default_client"/>
        </record>
    </data>
</odoo>